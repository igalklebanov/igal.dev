---
const tools = [
  {
    role: 'Editor',
    items: [
      { name: 'VS Code', href: 'https://code.visualstudio.com/' },
    ],
  },
  {
    role: 'Terminal',
    items: [
      { name: 'Ghostty', href: 'https://ghostty.org/' },
    ],
  },
  {
    role: 'Browser',
    items: [
      { name: 'Chrome', href: 'https://www.google.com/chrome/' },
    ],
  },
  {
    role: 'Launcher',
    items: [
      { name: 'Raycast', href: 'https://www.raycast.com/' },
    ],
  },
  {
    role: 'Agent workspace',
    items: [
      { name: 'Herdr', href: 'https://herdr.dev/' },
    ],
  },
  {
    role: 'Coding agents',
    items: [
      { name: 'Claude Code', href: 'https://claude.com/product/claude-code' },
      { name: 'Codex', href: 'https://openai.com/codex/' },
    ],
  },
];
const gear = [
  { name: 'Decoline Honey', role: 'Desk', detail: '', href: 'https://www.bamboo.co.il/p/355' },
  { name: '2 × ASUS VP249QGR', role: 'Monitors', detail: '1080p · 144 Hz', href: 'https://www.amazon.com/dp/B083FMP35T' },
  { name: 'Durgod Taurus K320', role: 'Keyboard', detail: 'White', href: 'https://www.amazon.com/dp/B07QDTRXVP' },
  { name: 'Logitech MX518 Legendary', role: 'Mouse', detail: '', href: 'https://www.amazon.com/dp/B07NDVF9V7' },
  { name: 'Razer Gigantus V2 3XL', role: 'Desk mat', detail: '120 × 55 cm', href: 'https://www.amazon.com/dp/B086RH28FW' },
  { name: 'Sennheiser HD 6XX', role: 'Headphones', detail: '', href: 'https://www.amazon.com/dp/B08T123MCT' },
  { name: 'Sony WF-1000XM6', role: 'Earbuds', detail: 'Black', href: 'https://www.amazon.com/dp/B0GF9ZNLWM' },
  { name: 'Elgato Wave:3 MK.2', role: 'Microphone', detail: '', href: 'https://www.amazon.com/dp/B0GGYLFHPS' },
  { name: 'Logitech C920', role: 'Webcam', detail: '', href: 'https://www.amazon.com/dp/B006JH8T3S' },
  { name: 'Steelcase Amia', role: 'Chair', detail: '', href: 'https://www.amazon.com/dp/B00GBUQ14M' },
];
---

<section id="setup" aria-labelledby="setup-heading">
  <h2 id="setup-heading">My setup</h2>
  <div class="setup-group">
    <h3>Devices</h3>
    <dl>
      <div>
        <dt>Laptop</dt>
        <dd>MacBook Pro 14″ · 2023 · Space Black</dd>
        <dd>Apple M3 Pro · 18 GB memory · 512 GB SSD</dd>
        <dd>11-core CPU · 14-core GPU</dd>
      </div>
      <div>
        <dt>Phone</dt>
        <dd>Samsung Galaxy S25 Ultra</dd>
        <dd>Titanium Black · 12 GB memory</dd>
        <dd>SM-S938B/DS</dd>
      </div>
    </dl>
  </div>
  <div class="setup-group">
    <h3>Developer tools</h3>
    <dl>
      {tools.map(({ role, items }) => (
        <div>
          <dt>{role}</dt>
          <dd>{items.map(({ name, href }, index) => (
            <>{index > 0 && ' · '}<a href={href} target="_blank" rel="noopener noreferrer">{name}</a></>
          ))}</dd>
        </div>
      ))}
    </dl>
  </div>
  <div class="setup-group">
    <h3>Desk &amp; gear</h3>
    <dl>
      {gear.map(({ name, role, detail, href }) => (
        <div>
          <dt>{role}</dt>
          <dd>{href ? <a href={href} target="_blank" rel="noopener noreferrer">{name}</a> : name}</dd>
          {detail && <dd>{detail}</dd>}
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  section { margin-top: 48px; }
  .setup-group { border-top: 1px solid var(--line); padding-block: 28px; }
  .setup-group:first-of-type { border-top-color: var(--ink); }
  h3 { margin-bottom: 22px; }
  dl { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; margin: 0; }
  dt { font-size: 15px; font-weight: 600; line-height: 1.5; overflow-wrap: anywhere; }
  dd a { text-decoration-color: var(--line); }
  dd { margin: 6px 0 0; color: var(--muted); font-size: 14px; line-height: 1.7; overflow-wrap: anywhere; }
  @media (min-width: 761px) and (max-width: 1000px) { dl { grid-template-columns: 1fr; } }
  @media (max-width: 760px) { section { margin-top: 42px; } .setup-group { padding-block: 25px; } }
  @media (max-width: 420px) { dl { grid-template-columns: 1fr; } }
</style>
