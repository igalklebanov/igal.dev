<footer id="elsewhere" class="profile-links">
  <nav aria-label="Find me elsewhere">
    <ul>
      {links.map(({ label, href, path, icon }) => (
        <li>
          <a href={href} aria-label={label} title={label}
             target={href.startsWith('https:') ? '_blank' : undefined}
             rel={href.startsWith('https:') ? 'noopener noreferrer' : undefined}>
            {path ? (
              <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true" focusable="false">
                <path d={path} />
              </svg>
            ) : icon === 'cal' ? (
              <svg viewBox="0 0 56 56" width="24" height="24" fill="none" aria-hidden="true" focusable="false"><rect width="56" height="56" rx="12" fill="#292929"/><path d="M18.628 36.781c2.846 0 4.946-1.096 6.183-2.59l-2.38-2.03c-.957 1.05-2.147 1.587-3.733 1.587-3.22 0-5.204-2.427-5.204-5.413 0-2.987 1.984-5.46 5.134-5.46 1.47 0 2.683.513 3.663 1.54l2.31-2.007c-1.47-1.75-3.313-2.567-5.973-2.567-5.04 0-8.517 3.803-8.517 8.493 0 4.667 3.663 8.447 8.517 8.447ZM31.69 36.781c2.17 0 3.267-.91 3.92-2.286v1.983h3.057V24.344H35.54v1.914c-.653-1.307-1.75-2.17-3.85-2.17-3.337 0-5.997 2.87-5.997 6.37s2.66 6.323 5.997 6.323Zm-2.847-6.346c0-1.89 1.354-3.5 3.36-3.5 2.077 0 3.407 1.633 3.407 3.523 0 1.89-1.33 3.477-3.407 3.477-2.006 0-3.36-1.657-3.36-3.5ZM41.472 36.478h3.15V19.444h-3.15v17.034Z" fill="#fff"/></svg>
            ) : (
              <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                <path d="m22 7-8.991 5.727a2 2 0 0 1-2.009 0L2 7" />
                <rect x="2" y="4" width="20" height="16" rx="2" />
              </svg>
            )}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</footer>

<style>
  .profile-links { margin-top: 24px; padding-top: 12px; border-top: 1px solid #21171340; }
  ul { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 4px 12px; margin: 0; padding: 0; list-style: none; }
  a { display: flex; align-items: center; justify-content: center; height: 44px; color: #211713; border-radius: 4px; text-decoration: none; }
  a:hover { color: #211713; background: #21171314; }
  a:focus-visible { outline: 2px solid #211713; outline-offset: 2px; }
  svg { display: block; flex-shrink: 0; }
</style>
